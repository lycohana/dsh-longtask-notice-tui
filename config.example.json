{
  "enabled": true,
  "thresholdSeconds": 600,
  "notify": {
    "completed": true,
    "failed": true,
    "cancelled": true,
    "inputRequired": true
  },
  "retry": {
    "maxAttempts": 3,
    "baseDelayMs": 1000,
    "maxDelayMs": 30000
  },
  "channels": [
    {
      "type": "smtp",
      "id": "default-email",
      "enabled": true,
      "host": "smtp.example.com",
      "port": 587,
      "secure": false,
      "requireTls": true,
      "from": "",
      "displayName": "dsh-TUI",
      "to": ["you@example.com"],
      "username": "dsh@example.com",
      "passwordRef": "DSH_NOTICE_SMTP_PASSWORD"
    },
    {
      "type": "webhook",
      "id": "default-webhook",
      "enabled": true,
      "url": "https://notify.example.com/dsh",
      "secretRef": "DSH_NOTICE_WEBHOOK_SECRET"
    },
    {
      "type": "bark",
      "id": "default-bark",
      "enabled": true,
      "apiUrl": "https://api.day.app",
      "deviceKeyRef": "DSH_NOTICE_BARK_DEVICE_KEY"
    }
  ]
}
